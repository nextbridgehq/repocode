{
  "name": "repocode",
  "version": "0.3.0",
  "description": "CLI to analyze, rank, and pack a repository into AI-ready context for LLMs and coding assistants",
  "keywords": [
    "ai",
    "context",
    "llm",
    "tokens",
    "cli",
    "codebase",
    "repocode",
    "repository",
    "coding-assistant",
    "ai-tools",
    "context-engineering",
    "developer-tools",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextbridgehq/repocode.git"
  },
  "homepage": "https://github.com/nextbridgehq/repocode",
  "bugs": {
    "url": "https://github.com/nextbridgehq/repocode/issues"
  },
  "type": "module",
  "bin": {
    "repocode": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repocode/core": "workspace:*",
    "@repocode/mcp": "workspace:*",
    "clipboardy": "^4.0.0",
    "commander": "^12.0.0",
    "ink": "^5.0.0",
    "kleur": "^4.1.5",
    "ora": "^8.0.0",
    "react": "^18.3.0",
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "vitest": "^4.1.10"
  }
}
