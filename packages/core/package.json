{
  "name": "@repocode/core",
  "version": "0.3.0",
  "description": "Core engine for RepoCode — repository analysis, ranking, token-budgeting, and AI-ready context assembly",
  "keywords": [
    "ai",
    "context",
    "llm",
    "tokens",
    "codebase",
    "repocode",
    "code-analysis",
    "repository-analysis",
    "code-intelligence",
    "llm-context",
    "token-optimization",
    "context-engineering",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextbridgehq/repocode.git"
  },
  "homepage": "https://github.com/nextbridgehq/repocode",
  "bugs": {
    "url": "https://github.com/nextbridgehq/repocode/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "grammars",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@secretlint/config-loader": "13.0.2",
    "@secretlint/core": "13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "chokidar": "^4.0.0",
    "globby": "^14.0.0",
    "ignore": "^5.3.0",
    "istextorbinary": "^9.0.0",
    "proper-lockfile": "4.1.2",
    "tiktoken": "^1.0.15",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
