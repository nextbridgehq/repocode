node_modules/
dist/
out/
docs/

# generated pack output
repocode-output.*

# benchmark harness and raw results: kept local. The methodology and headline numbers are
# published in BENCHMARKS.md; the harness itself and its per-run CSVs are not, because the
# results are only meaningful alongside the commit that produced them.
packages/.cache/
packages/stats/
packages/bench/
scripts/benchmark-chart.js

# stable-order state: per-checkout cache of the previous output ordering, rebuilt on demand
.repocode/

# viscraft audit/probe artifacts: local analysis, not published
.viscraft/

# Electron/crashpad noise written into the cwd by the editor, not by this project
debug.log

# test coverage
coverage/

# env / secrets
.env
.env.local
repocode-test-*
