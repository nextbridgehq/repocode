node_modules/
dist/
out/
docs/

# generated pack output
repocode-output.*

# benchmark runs: the harness (packages/bench) is tracked and the headline numbers are in
# BENCHMARKS.md. Per-run CSVs and the cloned-repo cache stay local, because a result is only
# meaningful alongside the commit that produced them.
packages/.cache/
packages/stats/
scripts/benchmark-chart.js

# stable-order state: per-checkout cache of the previous output ordering, rebuilt on demand
.repocode/

# viscraft audit/probe artifacts: local analysis, not published
.viscraft/

# Electron/crashpad noise written into the cwd by the editor, not by this project
debug.log

# test coverage
coverage/

# env / secrets
.env
.env.local
repocode-test-*
